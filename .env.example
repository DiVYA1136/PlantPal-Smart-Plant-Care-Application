# Environment Variables Template for PlantPal SaaS

# Firebase Configuration
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=plantpal-app-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=plantpal-app-demo
VITE_FIREBASE_STORAGE_BUCKET=plantpal-app-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# External API Keys (Optional - Application features fallback to internal datasets when missing)
VITE_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
VITE_PERENUAL_API_KEY=YOUR_PERENUAL_API_KEY
